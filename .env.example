# Built-in Local Ollama AI (Zero external AI accounts or API keys)
AI_PROVIDER="ollama"
AI_BASE_URL="http://127.0.0.1:11434/v1"
AI_MODEL="qwen2.5:3b"
OLLAMA_AUTO_PULL=true

# APP_URL: The URL where this app is hosted
APP_URL="http://localhost:3000"

# PORT: Port for the Express + Vite server (default: 3000)
PORT=3000

# DATA_DIR: Directory for persistent SQLite DB, FTS5 search index, and Ollama models
DATA_DIR="./data"

# Optional default IMAP/SMTP credentials for self-hosted deployments
IMAP_HOST=""
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=""
IMAP_PASS=""
SMTP_HOST=""
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
